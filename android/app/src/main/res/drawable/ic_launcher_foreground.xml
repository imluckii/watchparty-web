<?xml version="1.0" encoding="utf-8"?>
<!-- Watchparty launcher foreground: open ring (290°) + play glyph + two viewer
     dots in the top gap = "watch together".
     All art stays inside the 66dp adaptive-icon safe zone (max extent 31.5 from center 54,54; safe radius 33). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Art is nudged 10% outward from the safe-zone design so the mark reads at
         launcher sizes; still inside the 72dp mask. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.1"
        android:scaleY="1.1">
        <!-- Open ring: gap centred at 12 o'clock, round caps -->
        <path
            android:pathData="M70.06,31.06 A28,28 0 1 1 37.94,31.06"
            android:strokeColor="#EDEAF7"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:fillColor="#00000000"/>

        <!-- Viewer dot, right of gap -->
        <path
            android:fillColor="#EDEAF7"
            android:pathData="M60.3,26.72 m-4.5,0 a4.5,4.5 0 1 1 9,0 a4.5,4.5 0 1 1 -9,0"/>

        <!-- Viewer dot, left of gap -->
        <path
            android:fillColor="#EDEAF7"
            android:pathData="M47.7,26.72 m-4.5,0 a4.5,4.5 0 1 1 9,0 a4.5,4.5 0 1 1 -9,0"/>

        <!-- Play triangle, corners softened by a matching round-join stroke -->
        <path
            android:fillColor="#EDEAF7"
            android:strokeColor="#EDEAF7"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:pathData="M45.5,40.5 L69.5,54 L45.5,67.5 Z"/>
    </group>
</vector>
